# Only ANTHROPIC_API_KEY is required for summarisation.
# The ingestion + embedding + retrieval + evaluation pipeline runs WITHOUT any API key.
ANTHROPIC_API_KEY=

# Model selection (defaults to a Claude 4.x model). Override to try older/newer models.
ARAG_MODEL=claude-sonnet-4-6

# Sentence-transformers model used for embeddings. Runs locally on CPU.
ARAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Where to cache PDFs and extracted text.
ARAG_CACHE_DIR=runtime/cache
